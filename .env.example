# ==============================================================================
# TRUSTVAULT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local deployment or configure in Render Dashboard.
# NEVER commit the real .env file or credentials to Git.
# ==============================================================================

# Server Profile & Port
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database (Supabase PostgreSQL Connection)
# Example URL format: jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or direct: jdbc:postgresql://db.nxjtgudsmeolyolrgdqu.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.nxjtgudsmeolyolrgdqu.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password-here

# Supabase Storage Configuration
SUPABASE_URL=https://nxjtgudsmeolyolrgdqu.supabase.co
# Note: Use service_role secret key for backend storage mediation. Never expose in frontend.
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-here
SUPABASE_STORAGE_BUCKET=trustvault-documents

# Security Settings
# Set to 'true' in production (HTTPS / Render), 'false' for local HTTP development
SESSION_COOKIE_SECURE=false

# Optional Initial Admin Seed (used on first start if users table is empty)
TRUSTVAULT_ADMIN_EMAIL=admin@trustvault.local
TRUSTVAULT_ADMIN_PASSWORD=AdminPass123!
